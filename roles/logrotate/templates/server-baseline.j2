# Managed by infra-server-baseline (role: logrotate). Do not edit manually.
#
# The baseline writes its reports as .txt; .log is included so that anything an
# operator adds to the same directory is rotated too.
{{ baseline_logrotate_report_dir }}/*.log {{ baseline_logrotate_report_dir }}/*.txt {
	weekly
	rotate 8
	compress
	delaycompress
	missingok
	notifempty
	create 0640 root root
}
